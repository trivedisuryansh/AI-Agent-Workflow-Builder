# =============================================================================
# Copy to .env.local and fill in. Never commit the filled-in copy.
# Every variable below is actually read by the code; there are no decoys.
# =============================================================================

# --- Nhost (public, safe to ship to the browser) -----------------------------
# From your Nhost project dashboard. The web app builds its GraphQL and auth
# URLs from these two values.
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=

# --- Hasura (server-side only — NEVER prefixed NEXT_PUBLIC_) -----------------
# Used by the workflow engine and Action handlers to write run/step state.
# Reaching Hasura as admin is what lets the engine update rows the calling user
# is not permitted to write directly; every such call is gated by an explicit
# authorization check in the handler first.
HASURA_GRAPHQL_ENDPOINT=https://<subdomain>.hasura.<region>.nhost.run/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=

# --- Handler <-> Hasura shared secret ----------------------------------------
# Hasura sends this header on every Action and Event Trigger call. Handlers
# reject any request without it, so the /api/* endpoints cannot be driven
# directly from the internet.
ACTION_WEBHOOK_SECRET=

# Public base URL of the deployed Next.js app. Hasura Actions and Event
# Triggers call back into it. Locally: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# --- LLM provider (llm_call step) --------------------------------------------
# LLM_PROVIDER: groq | openrouter | gemini
# Leave LLM_API_KEY empty ONLY if you accept the disclosed offline stub; the
# engine logs a loud warning and marks step output with "stubbed": true.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=30000

# --- http_request step -------------------------------------------------------
HTTP_STEP_TIMEOUT_MS=10000
HTTP_STEP_MAX_RESPONSE_BYTES=262144
# SSRF guard. Keep false in production: blocks loopback, link-local, and RFC1918
# destinations, re-checked after DNS resolution. See docs/architecture.md.
HTTP_STEP_ALLOW_PRIVATE_NETWORK=false

# --- notify step -------------------------------------------------------------
# NOTIFY_MODE: log | slack   ("log" records the notification row and marks it
# sent without an external call — the Event Trigger path still runs end to end)
NOTIFY_MODE=log
SLACK_WEBHOOK_URL=

# --- retry policy defaults (per-step config can override) --------------------
STEP_MAX_ATTEMPTS=2
STEP_RETRY_BASE_DELAY_MS=500

# --- tests -------------------------------------------------------------------
# Integration tests sign in as these seeded users. Created by `npm run seed`.
SEED_PASSWORD=Passw0rd!seed
TEST_ORG_A_OWNER_EMAIL=owner.a@example.test
TEST_ORG_A_EDITOR_EMAIL=editor.a@example.test
TEST_ORG_A_VIEWER_EMAIL=viewer.a@example.test
TEST_ORG_B_OWNER_EMAIL=owner.b@example.test
